// Configuración de Prisma ORM
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Modelo de Productos
model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(255)
  descripcion String?  @db.Text
  precio      Float    @default(0)
  stock       Int      @default(0)
  categoria   String   @db.VarChar(100)
  categoriaRegistro Categoria @relation(fields: [categoria], references: [nombre], onUpdate: Cascade, onDelete: Restrict)
  etiqueta    String?  @db.VarChar(100)
  imagen      String?  @db.VarChar(500)
  imagenes    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoria])

  @@map("productos")
}

// Modelo de Usuarios & Administradores
model Usuario {
  id          Int         @id @default(autoincrement())
  email       String      @unique @db.VarChar(255)
  password    String      @db.VarChar(255)
  nombre      String      @db.VarChar(255)
  telefono    String?     @db.VarChar(50)
  role        String      @default("CLIENTE") @db.VarChar(50)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  pedidos     Pedido[]

  @@map("usuarios")
}

// Modelo de Registro de Pedidos Realizados (Sin estados complejos)
model Pedido {
  id                   Int      @id @default(autoincrement())
  codigo               String   @unique @db.VarChar(50)
  usuarioId            Int?
  usuario              Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  clienteNombre        String   @db.VarChar(255)
  clienteTelefono      String   @db.VarChar(50)
  clienteEmail         String?  @db.VarChar(255)
  items                Json
  total                Float    @default(0)
  direccionEntrega     String   @db.VarChar(255)
  barrioEntrega        String?  @db.VarChar(100)
  destinatario         String?  @db.VarChar(255)
  telefonoDestinatario String?  @db.VarChar(50)
  fechaEntrega         String?  @db.VarChar(100)
  mensajeTarjeta       String?  @db.Text
  estado               String   @default("PENDIENTE") @db.VarChar(50)
  createdAt            DateTime @default(now())

  @@map("pedidos")
}

// Modelo de Categorías
model Categoria {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique @db.VarChar(100)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  productos Producto[]

  @@map("categorias")
}

// Solo registra assets nuevos administrados; los recursos históricos no se borran.
model AssetCatalogo {
  id            String   @id @db.VarChar(36)
  publicId      String   @unique @db.VarChar(255)
  url           String?  @unique @db.VarChar(500)
  estado        String   @default("SUBIENDO") @db.VarChar(24)
  eliminarDesde DateTime?
  intentos      Int      @default(0)
  ultimoError   String?  @db.VarChar(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([estado, eliminarDesde])
  @@map("assets_catalogo")
}

// Modelo de Adicionales / Extras Configurables por el Administrador
model Adicional {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(255)
  precio      Float    @default(0)
  disponible  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("adicionales")
}


